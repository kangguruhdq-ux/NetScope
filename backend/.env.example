# NetScope Platform Environment Configuration
PROJECT_NAME="NetScope"
TAGLINE="Real-Time Network Operations Center & Diagnostics Platform"
VERSION="1.0.0"

# Security
SECRET_KEY="netscope_jwt_secret_key_change_in_production_environment_2026"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database: SQLite Async with WAL mode for dev, PostgreSQL for production
DATABASE_URL="sqlite+aiosqlite:///./netscope.db"
# DATABASE_URL="postgresql+asyncpg://netscope:secret@localhost:5432/netscope_db"

# Operating Mode:
# DEMO_MODE=true activates realistic simulator & shows [DEMO SIMULATOR] badge
# DEMO_MODE=false runs live physical network polling
DEMO_MODE=true

# Initial Default SuperAdmin Account
DEFAULT_ADMIN_USERNAME="admin"
DEFAULT_ADMIN_EMAIL="admin@netscope.local"
DEFAULT_ADMIN_PASSWORD="AdminPassword123!"
DEFAULT_ADMIN_FULLNAME="NOC Super Administrator"

# Network Polling Engine Tuning
MONITORING_CONCURRENCY_LIMIT=32
DEFAULT_DEVICE_TIMEOUT=2.5
DEFAULT_MONITORING_INTERVAL=15
